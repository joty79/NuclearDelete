Windows Registry Editor Version 5.00

; Files + folders permanent delete context menu (no Recycle Bin)
; Scope: current user only

[-HKEY_CURRENT_USER\Software\Classes\Directory\shell\NuclearDeleteFolder]
[-HKEY_CURRENT_USER\Software\Classes\Directory\shell\z_10_DeleteToOblivion]
[-HKEY_CURRENT_USER\Software\Classes\Directory\ContextMenus\DeleteToOblivion]
[-HKEY_CURRENT_USER\Software\Classes\Directory\shell\z_09_RecycleBinTools]
[-HKEY_CURRENT_USER\Software\Classes\Directory\ContextMenus\RecycleBinTools]
[-HKEY_CURRENT_USER\Software\Classes\Directory\Background\shell\z_09_RecycleBinTools]
[-HKEY_CURRENT_USER\Software\Classes\Directory\Background\ContextMenus\RecycleBinTools]
[-HKEY_CURRENT_USER\Software\Classes\AllFilesystemObjects\shell\z_10_DeleteToOblivion]
[-HKEY_CURRENT_USER\Software\Classes\AllFilesystemObjects\ContextMenus\DeleteToOblivion]

[HKEY_CURRENT_USER\Software\Classes\AllFilesystemObjects\shell\z_10_DeleteToOblivion]
"MUIVerb"="Delete to Oblivion"
"Icon"="D:\\Users\\joty79\\scripts\\NuclearDelete\\.assets\\nuke.ico"
"Position"="Bottom"
"SeparatorBefore"=""
"ExtendedSubCommandsKey"="AllFilesystemObjects\\ContextMenus\\DeleteToOblivion"

[HKEY_CURRENT_USER\Software\Classes\AllFilesystemObjects\ContextMenus\DeleteToOblivion\shell\run]
"MUIVerb"="Delete Permanently"
"Icon"="D:\\Users\\joty79\\scripts\\NuclearDelete\\.assets\\nuke.ico"
"MultiSelectModel"="Document"

[HKEY_CURRENT_USER\Software\Classes\AllFilesystemObjects\ContextMenus\DeleteToOblivion\shell\run\command]
@="wscript.exe \"D:\\Users\\joty79\\scripts\\NuclearDelete\\NuclearDeleteFolder.vbs\" \"%1\""

[HKEY_CURRENT_USER\Software\Classes\Directory\shell\z_09_RecycleBinTools]
"MUIVerb"="Recycle Bin"
"Icon"="D:\\Users\\joty79\\scripts\\NuclearDelete\\.assets\\nuke.ico"
"Position"="Bottom"
"SeparatorBefore"=""
"ExtendedSubCommandsKey"="Directory\\ContextMenus\\RecycleBinTools"

[HKEY_CURRENT_USER\Software\Classes\Directory\ContextMenus\RecycleBinTools\shell\run]
"MUIVerb"="Empty Recycle Bin (All Volumes)"
"Icon"="D:\\Users\\joty79\\scripts\\NuclearDelete\\.assets\\nuke.ico"

[HKEY_CURRENT_USER\Software\Classes\Directory\ContextMenus\RecycleBinTools\shell\run\command]
@="pwsh.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File \"D:\\Users\\joty79\\scripts\\NuclearDelete\\EmptyRecycleBinFast.ps1\""

[HKEY_CURRENT_USER\Software\Classes\Directory\Background\shell\z_09_RecycleBinTools]
"MUIVerb"="Recycle Bin"
"Icon"="D:\\Users\\joty79\\scripts\\NuclearDelete\\.assets\\nuke.ico"
"Position"="Bottom"
"SeparatorBefore"=""
"ExtendedSubCommandsKey"="Directory\\Background\\ContextMenus\\RecycleBinTools"

[HKEY_CURRENT_USER\Software\Classes\Directory\Background\ContextMenus\RecycleBinTools\shell\run]
"MUIVerb"="Empty Recycle Bin (All Volumes)"
"Icon"="D:\\Users\\joty79\\scripts\\NuclearDelete\\.assets\\nuke.ico"

[HKEY_CURRENT_USER\Software\Classes\Directory\Background\ContextMenus\RecycleBinTools\shell\run\command]
@="pwsh.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File \"D:\\Users\\joty79\\scripts\\NuclearDelete\\EmptyRecycleBinFast.ps1\""
